---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
      data-testid="game-filters"
      aria-label="Filter games"
    >
      <div class="grid gap-6 md:grid-cols-2">
        <fieldset>
          <legend class="mb-3 text-lg font-medium text-slate-100">Categories</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-slate-300">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="publisher-filter" class="mb-3 block text-lg font-medium text-slate-100">Publisher</label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="apply-filters"
        >
          Apply filters
        </button>
        <a
          href="/"
          class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </a>
      </div>
    </form>

    <p class="mb-6 text-slate-300" data-testid="filter-status" role="status" aria-live="polite"></p>
    <div data-testid="filtered-empty-state" class="hidden">
      <EmptyState text="No games match the selected filters." />
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => (
            <div
              data-category-id={game.category?.id ?? ''}
              data-publisher-id={game.publisher?.id ?? ''}
              data-filterable-game
            >
              <GameCard game={game} />
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-filterable-game]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (form && status && emptyState) {
    const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = (): void => {
      const params = new URLSearchParams(window.location.search);
      const selectedCategories = params.getAll('category');
      const selectedPublisher = params.get('publisher') ?? '';

      categoryInputs.forEach((input) => {
        input.checked = selectedCategories.includes(input.value);
      });
      if (publisherInput) publisherInput.value = selectedPublisher;

      let visibleCount = 0;
      cards.forEach((card) => {
        const categoryMatches =
          selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === (card.dataset.publisherId ?? '');
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount++;
      });

      emptyState.classList.toggle('hidden', visibleCount !== 0 || cards.length === 0);
      status.textContent =
        selectedCategories.length > 0 || selectedPublisher !== ''
          ? `${visibleCount} game${visibleCount === 1 ? '' : 's'} match the selected filters.`
          : `${visibleCount} game${visibleCount === 1 ? '' : 's'} available.`;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const params = new URLSearchParams();
      categoryInputs.filter((input) => input.checked).forEach((input) => params.append('category', input.value));
      if (publisherInput?.value) params.set('publisher', publisherInput.value);
      const query = params.toString();
      window.history.replaceState({}, '', query ? `/?${query}` : '/');
      applyFilters();
    });

    applyFilters();
  }
</script>
